{
  "name": "@bluprynt/sdk-registry",
  "version": "0.0.0",
  "description": "Bluprynt SDK registry — read and verify what Bluprynt publishes: identities, credentials, attestations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blupryntco/sdk.git",
    "directory": "packages/registry"
  },
  "homepage": "https://github.com/blupryntco/sdk#readme",
  "bugs": "https://github.com/blupryntco/sdk/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bluprynt/sdk-core": "workspace:*",
    "@digitalbazaar/credentials-context": "^3.2.0",
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/data-integrity-context": "^2.0.1",
    "@digitalbazaar/ecdsa-jcs-2019-cryptosuite": "^1.0.0",
    "@digitalbazaar/ecdsa-multikey": "^1.8.0",
    "@digitalbazaar/multikey-context": "^2.0.1",
    "@digitalbazaar/vc": "^7.3.0",
    "did-resolver": "^6.0.0",
    "web-did-resolver": "^3.2.0"
  },
  "license": "MIT"
}
