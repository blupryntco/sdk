{
  "name": "@bluprynt/sdk-client",
  "version": "0.2.0",
  "description": "Bluprynt SDK API client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blupryntco/sdk.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/blupryntco/sdk#readme",
  "bugs": "https://github.com/blupryntco/sdk/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "curl -sSf -o openapi.json https://integrations.bluprynt.com/openapi.json && pnpm dlx --package @hey-api/openapi-ts@0.97.3 --package typescript@6.0.3 openapi-ts -i openapi.json -o src/generated -p @hey-api/client-fetch @hey-api/typescript @hey-api/sdk",
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bluprynt/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "license": "MIT"
}
