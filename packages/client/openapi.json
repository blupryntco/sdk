"type":"string","enum":["contract_signature"]},"scheme":{"type":"string","enum":["eip1271"]},"inner_scheme":{"type":"string","enum":["eip191","eip712"]},"message":{"type":"string"},"signature":{"type":"string"},"caip2":{"type":"string","example":"eip155:1"},"block_number":{"type":"number","example":21000000}},"required":["type","scheme","inner_scheme","message","signature","caip2","block_number"]},"KyiAmountTransferMethod":{"type":"object","properties":{"type":{"type":"string","enum":["transfer"]},"kind":{"type":"string","enum":["amount"]},"caip2":{"type":"string","nullable":true,"example":"eip155:1"},"transaction_hash":{"type":"string","nullable":true},"sender":{"type":"string"},"recipient":{"type":"string","nullable":true},"asset":{"type":"string","nullable":true,"description":"CAIP-19 of the transferred asset","example":"eip155:1/slip44:60"},"amount":{"type":"string","nullable":true,"description":"Amount in base units of `asset`","example":"1230000000000"}},"required":["type","kind","caip2","transaction_hash","sender","recipient","asset","amount"]},"KyiMemoTransferMethod":{"type":"object","properties":{"type":{"type":"string","enum":["transfer"]},"kind":{"type":"string","enum":["memo"]},"caip2":{"type":"string","nullable":true},"transaction_hash":{"type":"string"},"sender":{"type":"string"},"recipient":{"type":"string","nullable":true},"memo":{"type":"string"}},"required":["type","kind","caip2","transaction_hash","sender","recipient","memo"]},"KyiAdminManualMethod":{"type":"object","properties":{"type":{"type":"string","enum":["admin_manual"],"description":"Not part of the public trust model"}},"required":["type"]},"KyiVerification":{"type":"object","properties":{"verified_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","nullable":true,"format":"date-time"},"wallet_address":{"type":"string","description":"Wallet whose proof backs the verification"},"authority":{"$ref":"#/components/schemas/KyiAuthority"},"method":{"oneOf":[{"$ref":"#/components/schemas/KyiSignatureMethod"},{"$ref":"#/components/schemas/KyiContractSignatureMethod"},{"$ref":"#/components/schemas/KyiAmountTransferMethod"},{"$ref":"#/components/schemas/KyiMemoTransferMethod"},{"$ref":"#/components/schemas/KyiAdminManualMethod"}]}},"required":["verified_at","expires_at","wallet_address","authority","method"]},"KyiTokenLookupItem":{"type":"object","properties":{"kyi_verified":{"type":"boolean"},"token":{"$ref":"#/components/schemas/KyiToken"},"asset":{"$ref":"#/components/schemas/KyiAsset"},"issuer":{"nullable":true,"allOf":[{"$ref":"#/components/schemas/KyiIssuer"}]},"authorities":{"type":"array","items":{"$ref":"#/components/schemas/KyiAuthority"}},"verifications":{"type":"array","items":{"$ref":"#/components/schemas/KyiVerification"}}},"required":["kyi_verified","token","asset","issuer","authorities","verifications"]},"KyiTokenLookup":{"type":"object","properties":{"kyi_verified":{"type":"boolean","description":"True if any item is KYI-verified"},"data":{"type":"array","items":{"$ref":"#/components/schemas/KyiTokenLookupItem"}}},"required":["kyi_verified","data"]},"ReferenceChain":{"type":"object","properties":{"caip2":{"type":"string","description":"CAIP-2 chain id","example":"eip155:1"},"namespace":{"type":"string","description":"CAIP-2 namespace","example":"eip155"},"reference":{"type":"string","description":"CAIP-2 reference","example":"1"},"slug":{"type":"string","description":"Chain slug, as accepted by `chain_slug`","example":"ethereum"},"name":{"type":"string","example":"Ethereum"},"mainnet":{"type":"boolean","description":"False for testnets and devnets","example":true}},"required":["caip2","namespace","reference","slug","name","mainnet"]},"ReferenceChainList":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/ReferenceChain"}}},"required":["data"]}}}}